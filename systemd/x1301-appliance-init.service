[Unit]
Description=X1301 appliance state and generated configuration bootstrap
After=x1301-edid.service
Wants=x1301-edid.service
Before=x1301-hdmi-watch.service

[Service]
Type=oneshot
User=x1301
Group=x1301
SupplementaryGroups=video audio
StateDirectory=x1301
StateDirectoryMode=0755
RuntimeDirectory=x1301
RuntimeDirectoryMode=0755
ExecStart=/usr/local/lib/x1301/x1301-appliance.py --once --bootstrap
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
