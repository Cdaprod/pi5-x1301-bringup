[Unit]
Description=X1301 profile, capability, and runtime reconciler
After=x1301-hdmi-watch.service
Requires=x1301-hdmi-watch.service

[Service]
Type=simple
User=x1301
Group=x1301
SupplementaryGroups=video audio
RuntimeDirectory=x1301
StateDirectory=x1301
ExecStart=/usr/local/lib/x1301/x1301-appliance.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
