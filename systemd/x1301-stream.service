[Unit]
Description=X1301 single encoder producer
After=x1301-appliance.service x1301-mediamtx.service
Wants=x1301-mediamtx.service

[Service]
User=x1301
Group=x1301
SupplementaryGroups=video audio
ExecStart=/usr/local/lib/x1301/x1301-stream.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
