[Unit]
Description=X1301 HDMI timing watcher
Requires=x1301-edid.service x1301-appliance-init.service
After=local-fs.target systemd-udev-settle.service x1301-edid.service x1301-appliance-init.service

[Service]
Type=simple
WorkingDirectory=/usr/local/lib/x1301
Environment=X1301_LOG_DIR=/var/lib/x1301
ExecStart=/usr/local/lib/x1301/hdmi-watch.sh --configure
Restart=on-failure
RestartSec=2
User=root
Group=x1301

[Install]
WantedBy=multi-user.target
