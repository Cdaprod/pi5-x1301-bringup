[Unit]
Description=X1301 HDMI timing watcher
After=local-fs.target systemd-udev-settle.service

[Service]
Type=simple
WorkingDirectory=/usr/local/lib/x1301
RuntimeDirectory=x1301
StateDirectory=x1301
Environment=X1301_LOG_DIR=/var/lib/x1301
ExecStart=/usr/local/lib/x1301/hdmi-watch.sh --configure
Restart=on-failure
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
